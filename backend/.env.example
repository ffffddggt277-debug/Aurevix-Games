APP_ENV=development
DATA_DIR=./var
FRONTEND_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.1-flash
ENABLE_GRADIO=1
PERSISTENCE_CONFIRMED=no
PORT=7860

# Mounted private HF Storage Bucket volume; leave empty only for local demo
PERSISTENT_DIR=

# app.py reads local .env by default; set to 0 to disable for test servers
LOAD_LOCAL_ENV=1
